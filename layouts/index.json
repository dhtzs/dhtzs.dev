{{- $index := slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) }}
        {{- $title := .Title -}}
        {{- $content := .Plain -}}
        {{- $permalink := .Permalink -}}
        {{- $resources := slice -}}
        {{- range .Resources -}}
            {{- $resources = $resources | append .Permalink -}}
        {{- end -}}
        {{- $index = $index | append (dict
            "title" $title
            "content" $content
            "permalink" $permalink
            "resources" $resources
        ) -}}
    {{- end }}
{{- end -}}
{{- $index | jsonify -}}
